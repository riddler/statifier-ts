{
  "description": "renewals already equals max_renewals, so the renewal guard is false: the chart stays in on_loan, nothing is cancelled, and the two timers the checkout sent are the only sends of the run.",
  "initial_configuration": [
    "on_loan"
  ],
  "steps": [
    {
      "event": {
        "name": "loan.renew"
      },
      "configuration": [
        "on_loan"
      ]
    }
  ],
  "host": {
    "send_types": [
      "library:timer",
      "library:route"
    ],
    "expect_sends": [
      {
        "type": "library:timer",
        "target": "loan",
        "event": {
          "name": "loan.due"
        },
        "delay_ms": 1814400000,
        "send_id": "due"
      },
      {
        "type": "library:timer",
        "target": "loan",
        "event": {
          "name": "loan.due_soon"
        },
        "delay_ms": 1555200000,
        "send_id": "due_soon"
      }
    ]
  }
}
