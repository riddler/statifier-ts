
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# The local beads interactions log. Every bd write appends to it, so a
# tracked copy dirtied the checkout on each one; the tracker itself syncs
# through its DoltHub remote, not through this file.
.beads/interactions.jsonl

# Changelog fragments are tracked. A global gitignore rule for `*.d` (C/C++
# dependency files) matches this directory name and would otherwise hide them.
!changelog.d/

# Node / TypeScript build output.
node_modules/
dist/
coverage/
reports/

# Temporary files, for example, from tests.
/tmp/

# The wurk kit's detached gate runner writes its run directory (meta.json,
# gate.log, result.json) here when it is given no run directory. Biome honours
# this file, so without the rule the gate lints the files its own run wrote.
/.claude/wurk-runs/

# A packed tarball of this package, written to the checkout root by `npm pack`
# or `pnpm pack`. It is a build artefact and must never be committed. The rule
# names this package's tarball only, so no other archive is hidden.
/riddler-statifier-*.tgz

# The generated API reference, built by `pnpm run docs` (typedoc). It is a
# build artefact and is never committed.
/docs/api/
